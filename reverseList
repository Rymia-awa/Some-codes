/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
struct ListNode* reverseList(struct ListNode* head) {
    struct ListNode *cur=head,*pre=NULL,*cn=NULL;
    while(cur!=NULL){
        cn=cur->next;
        cur->next=pre;
        pre=cur;
        cur=cn;
    }
    return pre;
}